# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# prebuild-Artefakte (siehe package.json -> prebuild). Beide werden bei jedem
# Build neu erzeugt und gehoeren deshalb nicht in die Versionierung:
# generate-og-images.tsx schrieb 199 PNGs mit 8,7 MiB pro Durchlauf neu,
# generate-htaccess.ts haengt vom Environment ab (CSP_MODE, Analytics-Origin) –
# eingecheckt lag dort die lokale report-only-Fassung ohne Umami-Origin.
/public/og/
/public/.htaccess

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
